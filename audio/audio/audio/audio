/* =====================================================================
   audio.js — background music button (next to the light / dark switch)
   =====================================================================
   WHAT IT DOES
   - Click the speaker button to play or pause the music.
   - LIGHT mode plays "Dusk in Mondstadt", DARK mode plays the Spiral Abyss
     battle themes. If you switch the theme while the music is playing, it
     changes track.
   - The tracks are your own files in the audio/ folder (HTML5 audio), so it
     also works when the site is opened straight from a folder.
   - Browsers block sound until you click, so it never starts by itself.
   - The position of each track is remembered while you move between the
     two pages, so the music continues from where you were.
   EDIT HERE: the file paths and volume in CONFIG.
   ===================================================================== */
(function () {
  'use strict';

  var btn = document.getElementById('audio-toggle');
  if (!btn) return;

  /* ---------- CONFIG ---------- */
  var CONFIG = {
    light: 'audio/dusk-in-mondstadt.mp3',
    dark: 'audio/spiral-abyss-battle-themes.mp3',
    volume: 0.10         // 0..1
  };

  var root = document.documentElement;
  var KEY = 'portfolio-audio-pos';
  var audio = new Audio();
  audio.loop = true;
  audio.preload = 'none';
  audio.volume = CONFIG.volume;

  var wantOn = false, current = null;   // current = 'light' | 'dark'

  function theme() { return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark'; }

  function readPos() {
    try { return JSON.parse(sessionStorage.getItem(KEY) || '{}') || {}; } catch (e) { return {}; }
  }
  function savePos() {
    if (!current || !audio.currentTime) return;
    var p = readPos(); p[current] = audio.currentTime;
    try { sessionStorage.setItem(KEY, JSON.stringify(p)); } catch (e) { /* ignore */ }
  }

  function setUI(on) {
    btn.classList.toggle('is-on', on);
    btn.setAttribute('aria-pressed', String(on));
    var label = on ? 'Pause music' : 'Play music';
    btn.setAttribute('aria-label', label);
    btn.setAttribute('title', label);
  }

  function fail(err) {
    wantOn = false; setUI(false);
    btn.classList.add('is-error');
    btn.setAttribute('title', 'Music file not found: check the audio/ folder and file names');
    console.warn('audio.js: could not play the music.', err || '');
  }

  function loadTrack(t) {
    savePos();
    current = t;
    audio.src = CONFIG[t];
    var start = readPos()[t] || 0;
    if (start > 0) {
      audio.addEventListener('loadedmetadata', function once() {
        audio.removeEventListener('loadedmetadata', once);
        try { audio.currentTime = start; } catch (e) { /* ignore */ }
      });
    }
  }

  function play() {
    var p = audio.play();
    if (p && p.catch) p.catch(fail);
  }

  function turnOn() {
    wantOn = true; setUI(true);
    btn.classList.remove('is-error');
    if (current !== theme()) loadTrack(theme());
    play();
  }
  function turnOff() {
    wantOn = false; setUI(false);
    savePos();
    audio.pause();
  }

  btn.addEventListener('click', function () { if (wantOn) turnOff(); else turnOn(); });
  audio.addEventListener('error', function () { if (audio.src) fail(audio.error); });

  // theme changed: switch to that mode's track (only if the music is playing)
  window.addEventListener('themechange', function () {
    if (wantOn && current !== theme()) { loadTrack(theme()); play(); }
  });
  setInterval(function () { if (wantOn) savePos(); }, 1000);
  window.addEventListener('pagehide', savePos);

  setUI(false);
})();